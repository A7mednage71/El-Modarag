    "onboarding_desc_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عِش تفاصيل النسخة الـ 23 التاريخية كما لم تفعل من قبل. تابع كل لحظة أسطورية، ترتيب المجموعات، ودراما الأدوار الإقصائية مباشرة من نيويورك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experience the historic 23rd edition like never before. Track every legendary moment, group standings, and knockout drama live from New York."
          }
        }
      }
    },
    "onboarding_desc_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تفوت نبضة واحدة. احصل على إشعارات فائقة السرعة، إحصائيات الأداء النخبوية، وتنبيهات الأهداف المباشرة لرونالدو وأكبر أيقونات العالم."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never miss a single heartbeat. Get ultra-fast notifications, elite performance stats, and live goal alerts for Ronaldo and the world's biggest icons."
          }
        }
      }
    },
    "onboarding_desc_3" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من كرة القدم إلى كرة السلة وأكثر! انضم إلى مجتمع “الصافره” لتوقع المباريات، التحليل مع المشجعين، وعيش شغفك الأقصى بشكل حركي."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From football to basketball and beyond! Join Whistle community to predict matches, analysis with fans, and live your ultimate passion natively."
          }
        }
      }
    },
    "onboarding_title_1" : {
